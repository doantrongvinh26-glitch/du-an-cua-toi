# Chép file này thành .env rồi điền khoá thật.
# TUYỆT ĐỐI không commit file .env lên git.

# Lấy tại: https://www.topview.ai/api-settings
TOPVIEW_API_KEY=

# Chỉ đặt nếu tài khoản bạn dùng địa chỉ API khác mặc định.
# TOPVIEW_BASE_URL=https://api.topview.ai

# --- Google Flow (module flow/) ---
# Không phải khoá bí mật, chỉ là giá trị mặc định cho đỡ phải gõ lại.
# FLOW_PROJECT_ID=
# FLOW_CDP_URL=http://localhost:9222
